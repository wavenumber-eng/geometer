{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": [
      "scripts/*.mjs",
      "src/ts/wn-geometer-contract-emitter/**/*.js",
      "src/ts/geometer/**/*.ts",
      "tests/typescript/*.mjs",
      "examples/wasm/embedded_model_viewer.js",
      "examples/wasm/**/*.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
