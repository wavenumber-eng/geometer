{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wavenumber.com/schemas/geometer-sdk-provenance.a0.json",
  "title": "Geometer static SDK external provenance sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": ["archive", "payload_inventory_sha256", "release_tag", "schema", "source_revision", "workflow"],
  "properties": {
    "schema": { "const": "wn.geometer.static_sdk_provenance.a0" },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "size"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1 }
      }
    },
    "payload_inventory_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "release_tag": { "type": "string", "pattern": "^v[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "run_id", "run_attempt"],
      "properties": {
        "repository": { "type": ["string", "null"] },
        "run_id": { "type": ["string", "null"] },
        "run_attempt": { "type": ["string", "null"] }
      }
    }
  }
}
