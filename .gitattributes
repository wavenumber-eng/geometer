* text=auto

.gitattributes text eol=lf

*.bat text eol=crlf
*.ps1 text eol=crlf

*.cmake text eol=lf
*.cpp text eol=lf
*.css text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.mjs text eol=lf
*.md text eol=lf
*.py text eol=lf
*.rs text eol=lf
