{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wavenumber:schema:geometer:geometry.hlr_projection.result:b0",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "geometry.hlr_projection.result.b0"
    },
    "units": {
      "type": "string",
      "const": "mm"
    },
    "empty": {
      "type": "boolean"
    },
    "source": {
      "$ref": "#/$defs/MeshCollectionHlrSource"
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HlrProjectedView"
      },
      "maxItems": 64
    },
    "timings": {
      "$ref": "#/$defs/HlrProjectionTimings"
    },
    "fragment": {
      "$ref": "#/$defs/FragmentMetadata"
    }
  },
  "required": [
    "schema",
    "units",
    "empty",
    "source",
    "views",
    "timings",
    "fragment"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "$defs": {
    "MeshCollectionHlrSource": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "mesh_collection"
        },
        "hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "kind",
        "hash"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "HlrProjectedView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "direction": {
          "$ref": "#/$defs/HlrVector3"
        },
        "up": {
          "$ref": "#/$defs/HlrVector3"
        },
        "modes": {
          "$ref": "#/$defs/HlrProjectionModes"
        }
      },
      "required": [
        "id",
        "direction",
        "up",
        "modes"
      ],
      "unevaluatedProperties": {
        "not": {}
      },
      "description": "Projection output in the view plane defined by direction and up. For\nup=[0,1,0], direction=[0,0,1] maps model (x,y) to view (x,y), while\ndirection=[0,0,-1] maps it to (-x,y). To place footprint-local output on a\nboard, use board_point = occurrence_transform * view_to_model * view_point;\nthe axial bottom view_to_model is diag(-1,1) in 2D and is distinct from the\nphysical bottom-side occurrence transform. This frame applies equally to\nsilhouette/detail/outline segments, arcs, and bounds."
    },
    "HlrProjectionTimings": {
      "type": "object",
      "properties": {
        "step_read_ms": {
          "type": "number",
          "minimum": 0
        },
        "mesh_ms": {
          "type": "number",
          "minimum": 0
        },
        "hlr_ms": {
          "type": "number",
          "minimum": 0
        },
        "extract_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "step_read_ms",
        "mesh_ms",
        "hlr_ms",
        "extract_ms"
      ],
      "unevaluatedProperties": {
        "not": {}
      },
      "description": "Timings are nondeterministic and excluded only by explicit conformance projections."
    },
    "FragmentMetadata": {
      "type": "object",
      "properties": {
        "clipping": {
          "$ref": "#/$defs/NormalizedClipping"
        },
        "input_triangles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000000
        },
        "output_triangles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000000
        },
        "fragment_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "linework_geometry_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "raw_attachment_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "input_triangles",
        "output_triangles",
        "fragment_sha256",
        "linework_geometry_sha256"
      ],
      "unevaluatedProperties": {
        "not": {}
      },
      "description": "Deterministic identity and size summary for the prepared world-space fragment."
    },
    "HlrVector3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "HlrProjectionModes": {
      "type": "object",
      "properties": {
        "outline": {
          "$ref": "#/$defs/ProjectedGeometry"
        },
        "detail": {
          "$ref": "#/$defs/ProjectedGeometry"
        },
        "bbox": {
          "$ref": "#/$defs/ProjectedGeometry"
        }
      },
      "required": [
        "outline",
        "detail",
        "bbox"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "NormalizedClipping": {
      "type": "object",
      "properties": {
        "planes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NormalizedHalfSpacePlane"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "cap_policy": {
          "type": "string",
          "const": "none"
        },
        "max_output_triangles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "max_generated_vertices": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "max_intersections": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "max_edge_plane_tests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "planes",
        "cap_policy",
        "max_output_triangles",
        "max_generated_vertices",
        "max_intersections",
        "max_edge_plane_tests"
      ],
      "unevaluatedProperties": {
        "not": {}
      },
      "description": "Fully resolved clipping values that participate in semantic identity."
    },
    "ProjectedGeometry": {
      "type": "object",
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectedSegment"
          },
          "maxItems": 4000000
        },
        "arcs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectedArc"
          },
          "maxItems": 4000000
        },
        "bounds": {
          "$ref": "#/$defs/ProjectionBounds",
          "description": "Omitted when this output layer is empty. The legacy B0 writer emits null."
        }
      },
      "required": [
        "segments",
        "arcs"
      ],
      "unevaluatedProperties": {
        "not": {}
      },
      "description": "Segments, arcs, and bounds expressed in the requested view-plane XY frame."
    },
    "NormalizedHalfSpacePlane": {
      "type": "object",
      "properties": {
        "normal": {
          "$ref": "#/$defs/IllustrationVector3"
        },
        "distance_mm": {
          "type": "number"
        },
        "tolerance_mm": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "normal",
        "distance_mm",
        "tolerance_mm"
      ],
      "unevaluatedProperties": {
        "not": {}
      },
      "description": "Canonical unit-normal plane returned in fragment metadata."
    },
    "ProjectedSegment": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "ProjectedArc": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "#/$defs/HlrVector2"
        },
        "end": {
          "$ref": "#/$defs/HlrVector2"
        },
        "center": {
          "$ref": "#/$defs/HlrVector2"
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "extent_rad": {
          "type": "number",
          "minimum": 0,
          "maximum": 6.283185307179586
        },
        "ccw": {
          "type": "boolean"
        },
        "full_circle": {
          "type": "boolean"
        }
      },
      "required": [
        "start",
        "end",
        "center",
        "radius",
        "extent_rad",
        "ccw",
        "full_circle"
      ],
      "unevaluatedProperties": {
        "not": {}
      },
      "description": "A circular arc expressed in the requested view-plane XY frame."
    },
    "ProjectionBounds": {
      "type": "object",
      "properties": {
        "min_x": {
          "type": "number"
        },
        "min_y": {
          "type": "number"
        },
        "max_x": {
          "type": "number"
        },
        "max_y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "min_x",
        "min_y",
        "max_x",
        "max_y",
        "width",
        "height"
      ],
      "unevaluatedProperties": {
        "not": {}
      },
      "description": "Axis-aligned bounds in the requested view-plane XY frame."
    },
    "IllustrationVector3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "HlrVector2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    }
  }
}
