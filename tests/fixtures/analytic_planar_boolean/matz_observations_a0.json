    "compact_shape_expansion": {
      "rectangle": "one authored outer ring with four authored vertex and line segment/curve identities",
      "region": "one authored identity per supplied ring, supplied vertex, and supplied line/arc segment",
      "disk": "one authored primitive-circle feature identity",
      "annulus": "authored outer-circle and inner-circle feature identities",
      "capsule": "one authored compact-capsule feature identity",
      "arc_sweep": "one authored swept-arc feature identity unless explicit logical boundary provenance is supplied",
      "line_arc_swept_path": "one authored path plus authored centerline vertex and segment/curve identities; offset boundaries are derived features unless explicitly identified"
    },
    "wire_neutrality": [
      "authored planar-region ring and segment identities must survive generated-client roundtrip",
      "compact primitive identities may become operand-relative canonical feature references rather than serialized lowered boundary rings",
      "compact primitive and compact arc-sweep helpers do not synthesize authored vertex identities",
      "explicit source_topology entries describe logical provenance observations and do not require callers to serialize solver-derived boundary topology",
      "the future Geometer TypeSpec and packet specification own the final authored-versus-derived representation"
    ]
  },
  "batch_failure_policy": {
    "untrusted_frame": "reject_batch",
    "isolated_geometry_or_normalization_failure": "fail_job_continue_batch",
    "dependent_relationship_query": "skipped_dependency_failed"
