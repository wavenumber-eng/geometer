        "name": {
          "type": "string",
          "const": "state_artifact"
        },
        "media_type": {
          "type": "string",
          "const": "application/vnd.opencascade.xml-xcaf"
        },
        "format": {
          "type": "string",
          "const": "ocaf-xml-xcaf-version-12"
