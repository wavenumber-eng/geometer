{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wavenumber:schema:geometer:geometry.model_illustration.result:a0",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "geometry.model_illustration.result.a0"
    },
    "svg": {
      "type": "string"
    },
    "bounds_mm": {
      "$ref": "#/$defs/ModelIllustrationBounds3MmA0",
      "description": "Prepared source bounds [min_x, min_y, min_z, max_x, max_y, max_z]."
    },
    "source": {
      "$ref": "#/$defs/ModelIllustrationSourceSummaryA0"
    },
    "stats": {
      "$ref": "#/$defs/MeshIllustrationRenderStats"
    },
    "timings": {
      "$ref": "#/$defs/ModelIllustrationTimingsA0"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 256
    }
  },
  "required": [
    "schema",
    "svg",
    "bounds_mm",
    "source",
    "stats",
    "timings",
    "warnings"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "$defs": {
    "ModelIllustrationBounds3MmA0": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 6,
      "maxItems": 6
    },
    "ModelIllustrationSourceSummaryA0": {
      "oneOf": [
        {
          "$ref": "#/$defs/ModelAttachmentSourceSummaryA0"
        },
        {
          "$ref": "#/$defs/AnalyticSourceSummaryA0"
        }
      ]
    },
    "MeshIllustrationRenderStats": {
      "type": "object",
      "properties": {
        "triangles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "surface_draws": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "layered_surfaces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "outlines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "details": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "creases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "commands": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "triangles",
        "surface_draws",
        "layered_surfaces",
        "outlines",
        "details",
        "creases",
        "commands"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "ModelIllustrationTimingsA0": {
      "type": "object",
      "properties": {
        "source_preparation_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Model import+tessellation or analytic validation+lowering."
        },
        "linework_ms": {
          "type": "number",
          "minimum": 0
        },
        "illustration_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Shading, ordering, fusion, and SVG construction when applicable."
        },
        "attachment_encoding_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Encoding a returned attachment, zero for the inline SVG operation."
        }
      },
      "required": [
        "source_preparation_ms",
        "linework_ms",
        "illustration_ms",
        "attachment_encoding_ms"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "ModelAttachmentSourceSummaryA0": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "model"
        },
        "media_type": {
          "$ref": "#/$defs/ModelAttachmentMediaTypeA0"
        },
        "source_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "meshes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "triangles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000000
        }
      },
      "required": [
        "kind",
        "media_type",
        "source_sha256",
        "meshes",
        "triangles"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "AnalyticSourceSummaryA0": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "analytic"
        },
        "definitions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "occurrences": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "primitives": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "triangles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000000
        }
      },
      "required": [
        "kind",
        "definitions",
        "occurrences",
        "primitives",
        "triangles"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "ModelAttachmentMediaTypeA0": {
      "type": "string",
      "enum": [
        "application/step",
        "model/step"
      ]
    }
  }
}
