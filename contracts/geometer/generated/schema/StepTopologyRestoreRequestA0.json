      "required": [
        "carrier",
        "name",
        "media_type",
        "format",
        "bytes",
        "sha256"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "StepAp242PersistenceArtifact": {
      "type": "object",
      "properties": {
        "carrier": {
          "type": "string",
          "const": "step_ap242"
        },
        "name": {
          "type": "string",
          "const": "state_artifact"
        },
        "media_type": {
          "type": "string",
          "const": "application/step"
        },
        "format": {
          "type": "string",
          "const": "ap242-managed-model-based-3d-engineering"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "carrier",
        "name",
        "media_type",
        "format",
        "bytes",
        "sha256"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "JsonSidecarPersistenceArtifact": {
      "type": "object",
      "properties": {
        "carrier": {
          "type": "string",
          "const": "json_sidecar"
        },
        "name": {
          "type": "string",
          "const": "state_artifact"
        },
        "media_type": {
          "type": "string",
          "const": "application/vnd.wavenumber.geometer.step-topology-sidecar+json"
        },
        "format": {
          "type": "string",
          "const": "geometer.step_topology_sidecar.a0"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "carrier",
        "name",
        "media_type",
        "format",
        "bytes",
        "sha256"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "EditJournalPersistenceArtifact": {
      "type": "object",
      "properties": {
        "carrier": {
          "type": "string",
          "const": "edit_journal"
        },
        "name": {
          "type": "string",
          "const": "state_artifact"
        },
        "media_type": {
          "type": "string",
          "const": "application/vnd.wavenumber.geometer.step-topology-edit-journal"
        },
        "format": {
          "type": "string",
          "const": "geometer.step_topology_edit_journal.a0"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "carrier",
        "name",
        "media_type",
        "format",
        "bytes",
        "sha256"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    }
  }
