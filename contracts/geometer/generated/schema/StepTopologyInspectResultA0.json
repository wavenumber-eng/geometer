        "definition_handle": {
          "type": "string",
          "minLength": 68,
          "maxLength": 68
        },
        "body_handles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 100000
        },
        "face_handles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1000000
        },
        "source_entity": {
          "$ref": "#/$defs/SourceEntityEvidence"
        }
