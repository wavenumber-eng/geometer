        "media_type": {
          "type": "string",
          "const": "application/vnd.wavenumber.geometer.step-topology-table"
        },
        "format": {
          "type": "string",
          "const": "wn.geometer.step-topology-table.a0"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
