{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2022", "DOM"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "noEmitOnError": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "../../dist/wasm/demos",
    "paths": {
      "@wavenumber/geometer": ["../../dist/npm/geometer/index.d.ts"],
      "@wavenumber/geometer/wasm": ["../../dist/npm/geometer/wasm.d.ts"],
      "@wavenumber/geometer/worker": ["../../dist/npm/geometer/worker.d.ts"],
      "@wavenumber/geometer/worker-host": ["../../dist/npm/geometer/worker-host.d.ts"],
      "/dist/npm/geometer/worker-host.js": ["../../dist/npm/geometer/worker-host.d.ts"]
    },
    "rootDir": ".",
    "strict": true,
    "target": "ES2022",
    "verbatimModuleSyntax": true
  },
  "include": ["model_bounds_demo.ts", "model_bounds_worker.ts"]
}
