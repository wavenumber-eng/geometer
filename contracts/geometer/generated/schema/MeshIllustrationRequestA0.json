{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wavenumber:schema:geometer:geometry.mesh_illustration.request:a0",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "geometry.mesh_illustration.request.a0"
    },
    "view": {
      "$ref": "#/$defs/MeshIllustrationView"
    },
    "prepare": {
      "$ref": "#/$defs/MeshIllustrationPrepareOptions"
    },
    "style": {
      "$ref": "urn:wavenumber:schema:geometer:geometry.mesh_illustration.style:a0"
    },
    "svg": {
      "$ref": "#/$defs/MeshIllustrationSvgOptions"
    }
  },
  "required": [
    "schema",
    "view"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "Native one-shot illustration settings. Meshes arrive in the required\nmesh_collection attachment governed by geometry.mesh_collection.a0.\nReuses existing illustration A0 options and result; does not compute HLR.",
  "$defs": {
    "MeshIllustrationView": {
      "type": "object",
      "properties": {
        "direction": {
          "$ref": "#/$defs/IllustrationVector3"
        },
        "up": {
          "$ref": "#/$defs/IllustrationVector3"
        },
        "mirror_x": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "direction",
        "up"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "MeshIllustrationPrepareOptions": {
      "type": "object",
      "properties": {
        "max_triangles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000000,
          "default": 750000
        },
        "weld_tolerance": {
          "type": "number",
          "default": 1e-7,
          "exclusiveMinimum": 0
        }
      },
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "MeshIllustrationSvgOptions": {
      "type": "object",
      "properties": {
        "coordinate_span": {
          "type": "integer",
          "minimum": 10000,
          "maximum": 1000000000,
          "default": 1000000
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "IllustrationVector3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
