{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2022", "DOM"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "noEmitOnError": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "../../dist/wasm/demos",
    "paths": {
      "@wavenumber/geometer": ["../../dist/wasm/npm/geometer/index.d.ts"],
      "@wavenumber/geometer/mesh-illustration": ["../../dist/wasm/npm/geometer/mesh-illustration.d.ts"],
      "@wavenumber/geometer/mesh-illustration-ao-experimental": ["../../dist/wasm/npm/geometer/mesh-illustration-ao-experimental.d.ts"],
      "@wavenumber/geometer/wasm": ["../../dist/wasm/npm/geometer/wasm.d.ts"],
      "@wavenumber/geometer/worker": ["../../dist/wasm/npm/geometer/worker.d.ts"],
      "@wavenumber/geometer/worker-host": ["../../dist/wasm/npm/geometer/worker-host.d.ts"],
      "/dist/wasm/npm/geometer/worker-host.js": ["../../dist/wasm/npm/geometer/worker-host.d.ts"]
    },
    "rootDir": ".",
    "strict": true,
    "target": "ES2022",
    "verbatimModuleSyntax": true
  },
  "include": [
    "demo-tooling/**/*.ts",
    "illustration_demo.ts",
    "illustration_demo_support.ts",
    "illustration_geometry_renderers.ts",
    "model_bounds_demo.ts",
    "model_bounds_worker.ts",
  ]
}
