      "type": "object",
      "properties": {
        "meshes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "instances": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "primitives": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "geometry_triangles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "instanced_triangles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000000
        }
      },
      "required": [
        "meshes",
        "instances",
        "primitives",
        "geometry_triangles",
        "instanced_triangles"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    }
  }
}
