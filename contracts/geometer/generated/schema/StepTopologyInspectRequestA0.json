{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wavenumber:schema:geometer:geometry.step_topology.inspect.request:a0",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "geometry.step_topology.inspect.request.a0"
    },
    "session": {
      "$ref": "#/$defs/SessionReference"
    },
    "page": {
      "$ref": "#/$defs/PageRequest"
    },
    "include_source_entity_evidence": {
      "type": "boolean"
    },
    "include_diagnostics": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "session",
    "page",
    "include_source_entity_evidence",
    "include_diagnostics"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "$defs": {
    "SessionReference": {
      "type": "object",
      "properties": {
        "session_handle": {
          "type": "string",
          "minLength": 68,
          "maxLength": 68
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "required": [
        "session_handle",
        "generation"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "PageRequest": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string",
          "maxLength": 256
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      },
      "required": [
        "limit"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    }
  }
}
