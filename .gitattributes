dist/wasm/demos/**/_headers text eol=lf

*.a binary
*.bin binary
*.dll binary
*.dylib binary
*.exe binary
*.glb binary
*.lib binary
*.png binary
*.so binary
*.ttf binary
*.wasm binary

# Preserve the upstream OFL text byte-for-byte, including its authored spacing.
docs/design/assets/fonts/Cousine/OFL.txt whitespace=-blank-at-eol

# Emscripten's generated modular loader retains an indented blank template line.
dist/wasm/browser/geometer.js whitespace=-blank-at-eol

# OCCT-authored STEP fixtures retain the writer's canonical trailing spacing.
tests/fixtures/step/generated_topology/*.step whitespace=-blank-at-eol

# CAD-authored embedded fixtures retain the source exporter's trailing spacing.
tests/fixtures/step/embedded_models/ABM8-272-T3.STEP whitespace=-blank-at-eol
