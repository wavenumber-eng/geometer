{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wavenumber:schema:geometer:geometer.ipc.request:a0",
  "type": "object",
  "properties": {
    "operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "request": {
      "$ref": "#/$defs/IpcRequestValueA0"
    }
  },
  "required": [
    "operation",
    "request"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "$defs": {
    "IpcRequestValueA0": {
      "oneOf": [
        {
          "$ref": "urn:wavenumber:schema:geometer:geometry.model_bounds.options:a0"
        },
        {
          "$ref": "#/$defs/PackedAttachmentProjectionA0"
        },
        {
          "$ref": "urn:wavenumber:schema:geometer:geometry.step_topology.open.request:a0"
        },
        {
          "$ref": "urn:wavenumber:schema:geometer:geometry.step_topology.close.request:a0"
        },
        {
          "$ref": "urn:wavenumber:schema:geometer:geometry.step_topology.inspect.request:a0"
        },
        {
          "$ref": "urn:wavenumber:schema:geometer:geometry.step_topology.render.request:a0"
        },
        {
          "$ref": "urn:wavenumber:schema:geometer:geometry.step_topology.resolve_hit.request:a0"
        },
        {
          "$ref": "urn:wavenumber:schema:geometer:geometry.step_topology.apply_logical_groups.request:a0"
        },
        {
          "$ref": "urn:wavenumber:schema:geometer:geometry.step_topology.apply_metadata_probes.request:a0"
        },
        {
          "$ref": "urn:wavenumber:schema:geometer:geometry.step_topology.checkpoint_edit_journal.request:a0"
        },
        {
          "$ref": "urn:wavenumber:schema:geometer:geometry.step_topology.apply_hierarchy.request:a0"
        },
        {
          "$ref": "urn:wavenumber:schema:geometer:geometry.step_topology.save.request:a0"
        },
        {
          "$ref": "urn:wavenumber:schema:geometer:geometry.step_topology.restore.request:a0"
        },
        {
          "$ref": "urn:wavenumber:schema:geometer:geometry.step_topology.analyze_recovery.request:a0"
        }
      ],
      "description": "Structurally representable request payloads for executable IPC A0.\nA variant is callable only when the negotiated runtime catalog advertises\nits operation; structural presence does not imply runtime availability."
    },
    "PackedAttachmentProjectionA0": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "packet": {
          "$ref": "#/$defs/PackedAttachmentReferenceA0"
        }
      },
      "required": [
        "schema",
        "packet"
      ],
      "unevaluatedProperties": {
        "not": {}
      },
      "description": "Minimal JSON value used while an operation's logical DTO projection remains deferred."
    },
    "PackedAttachmentReferenceA0": {
      "type": "object",
      "properties": {
        "attachment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "attachment",
        "format"
      ],
      "unevaluatedProperties": {
        "not": {}
      },
      "description": "A named binary attachment carrying a separately governed packed projection."
    }
  }
}
