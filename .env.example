# Copy this file to .env for local release uploads.
# Do not put real tokens in version control.

TWINE_USERNAME=__token__
TWINE_PASSWORD=

# Optional TestPyPI token if using a separate shell/session.
TESTPYPI_TWINE_USERNAME=__token__
TESTPYPI_TWINE_PASSWORD=

# Optional OCCT binary dependency cache settings. Normal local and CI builds
# read public immutable archives from artifacts.wavenumber.net by default.
GEOMETER_OCCT_BINARY=auto
# GEOMETER_OCCT_CACHE_PUBLIC_BASE_URL=https://artifacts.wavenumber.net
# GEOMETER_OCCT_PUBLIC_CACHE=off

# Cloudflare R2 S3-compatible credentials are only needed for producer uploads
# or for explicitly testing a private signed fallback path.
R2_BUCKET=wn-build-deps
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
