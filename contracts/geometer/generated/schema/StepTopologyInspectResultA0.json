        "shell_handles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 250000
        },
        "bounds_mm": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 6,
          "maxItems": 6
