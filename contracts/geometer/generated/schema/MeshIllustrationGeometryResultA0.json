{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wavenumber:schema:geometer:geometry.mesh_illustration_geometry.result:a0",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "geometry.mesh_illustration_geometry.result.a0"
    },
    "geometry": {
      "$ref": "#/$defs/IllustrationGeometryAttachment"
    },
    "stats": {
      "$ref": "#/$defs/MeshIllustrationRenderStats"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 256
    }
  },
  "required": [
    "schema",
    "geometry",
    "stats",
    "warnings"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "Small transport result; statistics/warnings must match the geometry attachment.",
  "$defs": {
    "IllustrationGeometryAttachment": {
      "type": "object",
      "properties": {
        "attachment": {
          "type": "string",
          "const": "illustration_geometry"
        },
        "schema": {
          "type": "string",
          "const": "geometry.mesh_illustration.geometry.a0"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "attachment",
        "schema",
        "byte_length",
        "sha256"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "MeshIllustrationRenderStats": {
      "type": "object",
      "properties": {
        "triangles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "surface_draws": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "layered_surfaces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "outlines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "details": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "creases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "commands": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "triangles",
        "surface_draws",
        "layered_surfaces",
        "outlines",
        "details",
        "creases",
        "commands"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    }
  }
}
