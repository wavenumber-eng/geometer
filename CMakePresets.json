{
    "version": 6,
    "configurePresets": [
        {
            "name": "default",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "GEOMETER_OCCT_LIBRARY_TYPE": "Static",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "shared-occt",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-shared-occt",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "GEOMETER_OCCT_LIBRARY_TYPE": "Shared",
                "GEOMETER_COPY_OCCT_RUNTIME": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ]
}
