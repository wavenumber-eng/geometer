          "minimum": 0,
          "maximum": 100000
        },
        "component_occurrences": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "bodies": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
